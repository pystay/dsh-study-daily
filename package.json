{
  "name": "@pystay/dsh-study-daily",
  "version": "0.1.0",
  "description": "Read-only Obsidian task search tool for DeepSeek Harness",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "core.js",
    "core.d.ts",
    "index.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check core.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "obsidian",
    "tasks",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pystay/dsh-study-daily.git"
  },
  "bugs": {
    "url": "https://github.com/pystay/dsh-study-daily/issues"
  },
  "homepage": "https://github.com/pystay/dsh-study-daily#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  }
}
